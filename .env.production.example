# ==============================================================================
# TailorPro Production Environment Configuration (.env.production)
# ==============================================================================
# Copy this file to .env on your production server:
#   cp .env.production.example .env
# Then generate the application key:
#   php artisan key:generate --force
# ==============================================================================

APP_NAME="TailorPro Enterprise"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Dhaka"
APP_URL=https://tailorpro.yourdomain.com
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production MySQL Database Connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tailorpro
DB_USERNAME=tailorpro_db_user
DB_PASSWORD=YOUR_STRONG_RANDOM_PASSWORD_HERE

# Production Caching & Sessions (Redis or Database)
# Use 'database' or 'redis' for persistent high performance
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=tailorpro_cache_

# Supabase Credentials (Used for live synchronization or final cutover data pull)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Mailer (For order alerts & receipts, optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tailorpro.yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Vite Production Flags
VITE_APP_NAME="${APP_NAME}"
